# Keep the build context small and the layer cache stable.
#
# node_modules is the important one: the host's copy is built for macOS/arm and
# would break inside the Alpine build stage. `npm ci` installs a clean tree.
node_modules
dist
dist-server

# The token lives here. It is injected as container environment at run time, so
# it has no business inside a build context or an image layer.
.env

.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.override.yml

# Docs and scratch output are not part of the build.
*.md
/*.png
.playwright-mcp
.claude

.DS_Store
.vscode
.idea
