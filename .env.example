# Copy to `.env` beside docker-compose.yml and fill in. Never commit `.env`.
#
# These are read by the api container at RUNTIME, not baked into the browser
# bundle. Do not rename any of them to VITE_* — Vite substitutes VITE_ variables
# into the JS text at build time, which would publish the token to anyone who
# can load the page.

# ---------------------------------------------------------------- connection
# Site origin. A trailing "/jira" or "/" is stripped automatically, so the URL
# copied out of the browser address bar works as-is.
JIRA_BASE_URL=https://verifone.atlassian.net

# Atlassian Cloud basic auth is email:token — the token alone is not enough.
JIRA_EMAIL=you@verifone.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
# Note this is NOT scoped: it carries your full permissions across Jira and
# Confluence. Treat it as a password.
JIRA_API_TOKEN=

# -------------------------------------------------------------- which epics
# Default discovery is: labels = "<CONSTELLATION_LABEL>" AND issuetype = Epic
CONSTELLATION_LABEL=constellation

# Escape hatch: when set, this replaces the query above outright. Useful before
# the label exists anywhere — point it at a project or a literal list of keys.
# This instance rejects unbounded JQL, so always include a restriction.
#JIRA_EPIC_JQL=project = TAXENG AND issuetype = Epic
#JIRA_EPIC_JQL=key in ("TAXENG-8400", "ONBRD-2100")

# ------------------------------------------------------------- dependencies
# Dependencies come from issue links, never from a status.
#
# JIRA_BLOCKS_LINK_TYPES: types phrased like Jira's built-in "Blocks", where the
# OUTWARD issue is the blocker (outward "blocks", inward "is blocked by").
JIRA_BLOCKS_LINK_TYPES=Blocks

# JIRA_DEPENDS_LINK_TYPES: types phrased the other way round, where the OUTWARD
# issue is the one that depends (e.g. outward "depends on"). Getting a type into
# the wrong list reverses every arrow it produces, so check the phrasing in
# Jira Settings → Issues → Issue linking before adding one.
JIRA_DEPENDS_LINK_TYPES=

# ------------------------------------------------------------------ statuses
# Comma-separated Jira status NAMES, case-insensitive. Several Jira statuses
# legitimately mean the same thing and only your instance knows which.
#
# Anything unlisted falls back to Jira's status category, and every unmapped
# name is reported in a banner in the app so you can add it. "blocked" is the
# exception: Jira has no such category, so it only ever comes from the list
# below — a ticket is otherwise only "waiting" because of a link.
JIRA_STATUS_TODO=To Do,Open,Backlog
JIRA_STATUS_IN_PROGRESS=In Progress,In Review,In Development
JIRA_STATUS_BLOCKED=Blocked,On Hold
JIRA_STATUS_DONE=Done,Closed,Resolved

# --------------------------------------------------------------------- misc
# Story points are a custom field whose id differs per instance. Verify yours.
JIRA_STORY_POINTS_FIELD=customfield_10016

# Seconds the api holds a fetched galaxy. Concurrent requests share one fetch
# regardless, so a shared standup screen does not hammer Jira.
GALAXY_CACHE_TTL=120

# Serve the fixture instead of calling Jira — for working on the visual layer
# with no connection. Any other value (or unset) means Jira.
#CONSTELLATION_SOURCE=dummy

# Host port for the web container.
#CONSTELLATION_PORT=8080
